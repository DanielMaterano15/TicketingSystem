<Window x:Class="JKENGINEPARTS.TICKETING.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JKENGINEPARTS.TICKETING"
        mc:Ignorable="d"
        Title="Ticketing System" Height="450" Width="800">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" /> <ColumnDefinition Width="3*" /> </Grid.ColumnDefinitions>
        
        <Border Background="White" CornerRadius="8" Margin="0,0,10,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="Gray" Opacity="0.1" ShadowDepth="2"/>
            </Border.Effect>
            
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Tickets de Talleres" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#2C3E50" />
                
                <DataGrid x:Name="dgTickets" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Taller" Binding="{Binding TallerNombre}" Width="1*" />
                        <DataGridTextColumn Header="Vehiculo" Binding="{Binding VehiculoInfo}" Width="1.5*" />
                        <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="1*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        
        <Border Grid.Column="1" Background="White" CornerRadius="8" Margin="10,0,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="Gray" Opacity="0.1" ShadowDepth="2"/>
            </Border.Effect>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>    <RowDefinition Height="Auto"/> </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="Detalle de Solicitud" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock x:Name="lblVehiculo" Text="Selecciona un ticket para ver los detalles del vehículo..." FontSize="14" Foreground="#7F8C8D" Margin="0,5,0,0"/>
                </StackPanel>

                <DataGrid Grid.Row="1" x:Name="dgItemsCotizacion" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Repuesto Solicitado" Binding="{Binding RepuestoSolicitado}" IsReadOnly="True" Width="1.5*" />
                        <DataGridTextColumn Header="Descripción Exacta (JK)" Binding="{Binding DescripcionOfrecida}" Width="1.5*" />
                        <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="1*" />
                        <DataGridTextColumn Header="Precio Mayor ($)" Binding="{Binding PrecioMayor}" Width="1*" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="btnGuardarCotizacion" Content="Enviar Cotización al Taller" Width="180" Height="35" Background="#2E7D32" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                    <Button x:Name="btnCopiarVenta" Content="Copiar Texto VENTA" Width="150" Height="35" Background="#1565C0" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
